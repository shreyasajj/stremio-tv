+++ b/player/audio.c
@@ -427,6 +427,9 @@ static int reinit_audio_filters_and_output(struct MPContext *mpctx)
     if (opts->audio_stream_silence)
         ao_flags |= AO_INIT_STREAM_SILENCE;
 
