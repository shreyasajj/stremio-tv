From 5ae8b72bdb3f8e5bacf315d62c0bb1ada93da831 Mon Sep 17 00:00:00 2001
From: shreyasajj <shreyas.github@proton.me>
Date: Thu, 5 Nov 2026 13:57:19 -0600
Subject: [PATCH 2/2] ao_pipewire: pad spdif output with pause bursts

When paused with --audio-stream-silence, or on underrun, on_process()
queues short or zero-length buffers. With a spdif format and
--audio-spdif-pause-bursts, prefill the buffer with pause bursts (they
remain if the buffer lock is busy), pad, and always queue a full buffer.

Builds; not tested with PipeWire and a receiver.
---
 audio/out/ao_pipewire.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/audio/out/ao_pipewire.c b/audio/out/ao_pipewire.c
index 62bf5df765..514415594d 100644
--- a/audio/out/ao_pipewire.c
+++ b/audio/out/ao_pipewire.c
@@ -199,7 +199,17 @@ static void on_process(void *userdata)
     end_time += MP_TIME_S_TO_NS(time.buffered) / ao->samplerate;
     end_time -= pw_stream_get_nsec(p->stream) - time.now;
 
-    int samples = ao_read_data(ao, data, nframes, end_time, NULL, false, false);
+    int samples;
+    if (ao_spdif_pause_active(ao)) {
+        // A bitstream can't have gaps: the sink can't fill IEC 61937 with
+        // silence and replays stale data. Prefill with pause bursts (they
+        // stay if the buffer lock is busy) and always queue a full buffer.
+        ao_fill_silence(ao, data, 0, nframes);
+        ao_read_data(ao, data, nframes, end_time, NULL, true, false);
+        samples = nframes;
+    } else {
+        samples = ao_read_data(ao, data, nframes, end_time, NULL, false, false);
+    }
     b->size = samples;
 
     for (int i = 0; i < buf->n_datas; i++) {
-- 
