     float softvol_volume;
diff --git a/player/audio.c b/player/audio.c
index b3e975d..79bb408 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -425,6 +425,9 @@ static int reinit_audio_filters_and_output(struct MPContext *mpctx)
     if (opts->audio_stream_silence)
         ao_flags |= AO_INIT_STREAM_SILENCE;
 
+    if (opts->audio_spdif_pause_bursts)
